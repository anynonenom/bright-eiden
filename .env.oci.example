# ═══════════════════════════════════════════════════════════════
#  EIDEN × BrightBean Studio — Oracle Cloud Environment Template
#  Copy this file to .env and fill in every value.
#  Never commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ── Core ────────────────────────────────────────────────────────
SECRET_KEY=<generate: python -c "import secrets; print(secrets.token_urlsafe(50))">
ENCRYPTION_KEY_SALT=<generate: python -c "import secrets; print(secrets.token_urlsafe(32))">
DEBUG=false
ALLOWED_HOSTS=<your-domain.com>,<your-oci-vm-public-ip>
APP_URL=https://<your-domain.com>
APP_DOMAIN=<your-domain.com>

# ── Database ────────────────────────────────────────────────────
# Option A: Containerised PostgreSQL (default, free)
POSTGRES_DB=brightbean
POSTGRES_USER=brightbean
POSTGRES_PASSWORD=<strong-random-password>
DATABASE_URL=postgres://brightbean:<strong-random-password>@postgres:5432/brightbean

# Option B: OCI Autonomous Database (uncomment and fill)
# DATABASE_URL=postgres://<user>:<password>@<host>:5432/<dbname>?sslmode=require

# ── Storage: OCI Object Storage (S3-compatible) ─────────────────
# Create a bucket in your OCI tenancy:
#   OCI Console → Object Storage → Buckets → Create Bucket
# Create a Customer Secret Key (S3 credentials):
#   OCI Console → Profile → Customer Secret Keys → Generate Secret Key
#
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
S3_ACCESS_KEY_ID=<oci-customer-secret-key-access-key>
S3_SECRET_ACCESS_KEY=<oci-customer-secret-key-secret>
S3_BUCKET_NAME=<your-bucket-name>
S3_REGION_NAME=<oci-region e.g. eu-frankfurt-1>
# Optional: CDN or pre-authenticated request URL for public media
S3_CUSTOM_DOMAIN=

# Local media fallback (only if STORAGE_BACKEND=local)
MEDIA_ROOT=/app/media

# ── Email (SMTP) ─────────────────────────────────────────────────
EMAIL_BACKEND_TYPE=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=<your@email.com>
EMAIL_HOST_PASSWORD=<app-password>
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@<your-domain.com>

# ── Google OAuth (user login) ─────────────────────────────────
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# ── Platform Credentials ──────────────────────────────────────
PLATFORM_FACEBOOK_APP_ID=
PLATFORM_FACEBOOK_APP_SECRET=
PLATFORM_INSTAGRAM_APP_ID=
PLATFORM_INSTAGRAM_APP_SECRET=
PLATFORM_LINKEDIN_CLIENT_ID=
PLATFORM_LINKEDIN_CLIENT_SECRET=
PLATFORM_LINKEDIN_PERSONAL_CLIENT_ID=
PLATFORM_LINKEDIN_PERSONAL_CLIENT_SECRET=
PLATFORM_TIKTOK_CLIENT_KEY=
PLATFORM_TIKTOK_CLIENT_SECRET=
PLATFORM_PINTEREST_APP_ID=
PLATFORM_PINTEREST_APP_SECRET=
PLATFORM_GOOGLE_BUSINESS_CLIENT_ID=
PLATFORM_GOOGLE_BUSINESS_CLIENT_SECRET=
PLATFORM_THREADS_APP_ID=
PLATFORM_THREADS_APP_SECRET=
PLATFORM_YOUTUBE_CLIENT_ID=
PLATFORM_YOUTUBE_CLIENT_SECRET=

# ── Sentry (optional error tracking) ─────────────────────────
SENTRY_DSN=

# ── OCI-Specific Notes ────────────────────────────────────────
# 1. Open ports 80 and 443 in your OCI Security List or NSG
# 2. Allow port 22 only from your IP (not 0.0.0.0/0)
# 3. OCI Object Storage namespace: OCI Console → Tenancy → Object Storage namespace
# 4. OCI regions: ap-mumbai-1, eu-frankfurt-1, us-ashburn-1, etc.
